BASE_DIR = os.path.dirname(os.path.abspath(__file__))

files = (
    glob.glob(os.path.join(BASE_DIR, "*.html")) +
    glob.glob(os.path.join(BASE_DIR, "servicios", "*.html"))
)

# ── Reemplazos a nivel de BYTES (orden: más largos primero) ──────────────────
