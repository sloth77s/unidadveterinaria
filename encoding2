    (b'\xc3\x85\xc2\xb8\xc3\xa2\xc2\x80\xc2\x98\xc3\x82\xc2\x8d', '❤️'.encode()),
    # Remanentes Å¸â genéricos
    (b'\xc3\x85\xc2\xb8\xc3\xa2\xc2\x80', b''),
