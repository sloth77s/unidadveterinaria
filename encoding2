# ── Reemplazos a nivel de TEXTO (para limpiar restos visibles) ────────────────
# Estos limpian el "Á°" que queda delante de emojis ya convertidos
TEXT_FIXES = [
    # Á° delante de emojis de contacto
    ('Á°📍', '📍'),
    ('Á°📞', '📞'),
    ('Á°📸', '📸'),
    ('Á°🕐', '🕐'),
    ('Á°✔', '✔'),
    # Á° delante de emojis de reseñas
    ('Á°🐾', '🐾'),
    ('Á°🐕', '🐕'),
    ('Á°🏆', '🏆'),
    ('Á°❤️', '❤️'),
    # Cualquier Á° que quede suelto
    ('Á°', ''),
    # ÁÂ¡ -> ¡ (texto visible residual)
    ('ÁÂ¡', '¡'),
    ('ÁÂ¿', '¿'),
]

fixed = 0
for filepath in files:
    with open(filepath, 'rb') as f:
        original_bytes = f.read()

    # Paso 1: arreglos a nivel de bytes
    content = original_bytes
    for bad, good in BYTE_FIXES:
        content = content.replace(bad, good)

    # Paso 2: arreglos a nivel de texto (para residuos visibles)
    text = content.decode('utf-8', errors='replace')
    for bad, good in TEXT_FIXES:
        text = text.replace(bad, good)
    content = text.encode('utf-8')

    if content != original_bytes:
        with open(filepath, 'wb') as f:
            f.write(content)
        print(f"  CORREGIDO: {os.path.relpath(filepath, BASE_DIR)}")
        fixed += 1
    else:
        print(f"  OK:        {os.path.relpath(filepath, BASE_DIR)}")

print(f"\n✅ Listo. {fixed} archivo(s) corregido(s).")
print("   Ahora haz commit, push y despliega.")
